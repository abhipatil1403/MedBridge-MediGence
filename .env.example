# Public project values only. Do not put a service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agent workspace credentials are server-only. Never prefix them with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Optional server-only exact host routing. Leave empty for current path-based portals.
# Configure real domains in Vercel and Supabase Auth before enabling.
# Example: {"provider":"provider.example.com","support":"support.example.com","admin":"admin.example.com"}
MEDBRIDGE_PORTAL_HOSTS=

# Document security: enable only after a private scanner host is approved and tested.
# Generate a strong random token locally; use the identical server-only value on the worker.
MEDBRIDGE_DOCUMENT_SCANNER_ENABLED=false
MEDBRIDGE_DOCUMENT_SCANNER_TOKEN=
# Worker host only (never required in Vercel): approved bare HTTPS MedBridge origin,
# ClamAV executable and FreshClam-managed signature directory.
MEDBRIDGE_SCANNER_ORIGIN=
CLAMSCAN_PATH=clamscan
CLAMAV_DATABASE_DIR=
# Recommended worker transport: ClamAV on a local Unix socket or loopback TCP port.
CLAMD_SOCKET=
CLAMD_PORT=
